# ApexPrint AI Intelligence - Web Frontend Environment Configuration
# Configurable API Base URL for backend communication
# In local development: http://localhost:8000/api/v1 (or uses Vite proxy)
# In production on Vercel: set to your deployed FastAPI backend URL, e.g. https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional URL for legacy Streamlit UI
VITE_STREAMLIT_URL=http://localhost:8501
