# ==============================================================================
# Environment Configuration - Multi-Context RAG + MCP Platform (v1.0.0-rc1)
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Storage Paths (Local Ephemeral + Google Drive First Policy)
GOOGLE_DRIVE_ROOT=G:\My Drive\Internship_RAG_MCP_Capstone
LOCAL_EPHEMERAL_CHROMA_DIR=.chroma_live
LOCAL_MAX_STORAGE_BUDGET_MB=1024

# Model & LLM Provider Configuration
# Supported providers: colab_remote, local, auto, groq, gemini, ollama, mock
LLM_PROVIDER=colab_remote
ALLOW_LOCAL_FALLBACK=true
COLAB_API_ENDPOINT=http://localhost:8001/v1
COLAB_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_ENDPOINT=http://localhost:11434/v1
DEFAULT_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
MAX_GENERATION_TOKENS=512
REMOTE_INFERENCE_TIMEOUT=30.0

# Mock Policy (Strictly False in production and evaluation to prevent silent fallbacks)
ALLOW_MOCK_FALLBACK=false
TEST_MODE=false

# Embedding Configuration
EMBEDDING_PROVIDER=remote
ALLOW_LOCAL_EMBEDDINGS=false
REMOTE_EMBEDDING_ENDPOINT=http://localhost:8001/v1/embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DISTANCE_METRIC=cosine

# Retrieval & Hybrid Search
CHROMA_COLLECTION_NAME=apexprint_knowledge_base
TOP_K_RETRIEVAL=5
HYBRID_SEARCH_ALPHA=0.6
BM25_ENABLED=true

# Active Learning & Feedback
CONFIDENCE_THRESHOLD_CLARIFY=0.65
HUMAN_FEEDBACK_AUTO_ARCHIVE=true
