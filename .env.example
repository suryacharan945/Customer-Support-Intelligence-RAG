# ==============================================================================
# Environment Configuration - Multi-Context RAG + MCP Platform
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Storage Paths (Google Drive First Policy)
GOOGLE_DRIVE_ROOT=G:\My Drive\Internship_RAG_MCP_Capstone
LOCAL_EPHEMERAL_CHROMA_DIR=.chroma_live
LOCAL_MAX_STORAGE_BUDGET_MB=1024

# Model & LLM Provider Configuration
# Supported providers: colab_remote, groq, gemini, local_mock
LLM_PROVIDER=colab_remote
COLAB_API_ENDPOINT=http://localhost:8001/v1
GROQ_API_KEY=
GEMINI_API_KEY=
DEFAULT_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Retrieval & Hybrid Search
TOP_K_RETRIEVAL=5
HYBRID_SEARCH_ALPHA=0.6
BM25_ENABLED=true

# Active Learning & Feedback
CONFIDENCE_THRESHOLD_CLARIFY=0.65
HUMAN_FEEDBACK_AUTO_ARCHIVE=true
